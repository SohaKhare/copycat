# CopyCat frontend — copy to .env.local for local dev, or set in Vercel → Settings → Environment Variables.

# FastAPI backend URL (browser calls this directly; backend must allow your origin via CORS).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: longer proxy timeout when NOT using NEXT_PUBLIC_API_URL (Vercel Pro only).
# BACKEND_PROXY_MAX_DURATION_SEC=800
